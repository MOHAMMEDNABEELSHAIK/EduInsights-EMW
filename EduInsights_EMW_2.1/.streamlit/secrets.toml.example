# Copy this file to secrets.toml and replace both hashes with SHA-256 hashes
# of strong, unique passwords. Never commit secrets.toml to Git.
# Generate a hash with: python -c "import hashlib; print(hashlib.sha256(b'YOUR_STRONG_PASSWORD').hexdigest())"
[users.emwadmin]
password_hash = "REPLACE_WITH_SHA256_HASH"
role = "admin"

[users.analyst]
password_hash = "REPLACE_WITH_SHA256_HASH"
role = "analyst"
